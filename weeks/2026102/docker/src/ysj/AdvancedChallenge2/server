#!/usr/bin/env python3
import sys
import time
from datetime import datetime, timezone
from random import randint

events = [
    ("stdout", "INFO server starting on 127.0.0.1:8080"),
    ("stdout", "INFO loaded configuration"),
    ("stderr", "WARNING cache directory is nearing its size limit"),
    ("stdout", "INFO accepted connection client=alpha"),
    ("stderr", "ERROR failed to parse request client=bravo"),
    ("stdout", "INFO request complete status=200 client=alpha"),
    ("stderr", "CRITICAL database connection lost"),
    ("stdout", "INFO reconnecting to database"),
    ("stdout", "INFO database connection restored"),
    ("stderr", "WARNING slow request detected duration_ms=820"),
    ("stdout", "INFO accepted connection client=charlie"),
    ("stderr", "CRITICAL worker exited unexpectedly worker=3"),
    ("stdout", "INFO worker restarted worker=3"),
    ("stdout", "INFO healthcheck status=ok"),
]

forceExit = False
while not forceExit:
    event = events[randint(0, len(events)-1)]
    stream, message = event
    target = sys.stdout if stream == "stdout" else sys.stderr
    if message[0] == 'C':
        if randint(0,4) == 4:
            forceExit=True
            message += " TERMINAL ERROR, PROGRAM EXIT"
    print(message, file=target, flush=True)
    time.sleep(0.05)